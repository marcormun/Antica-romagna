---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<header class="page-hero">
  <div class="container container-narrow">
    <p class="kicker reveal">{kicker}</p>
    <h1 class="reveal" style="--d:80ms">{title}</h1>
    {lead && <p class="lead muted reveal" style="--d:160ms">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    text-align: center;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto;
    height: 120%;
    background: radial-gradient(50% 50% at 50% 50%, rgb(192 138 62 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .page-hero > * {
    position: relative;
  }
  .kicker {
    justify-content: center;
  }
  .kicker::after {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  h1 {
    margin-bottom: 1rem;
  }
  .lead {
    max-width: 56ch;
    margin-inline: auto;
  }
</style>
