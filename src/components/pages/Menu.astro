---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { routes, useTranslations, type Lang } from '../../i18n/ui';
import { menu, tr } from '../../data/menu';
import { menuSchema } from '../../data/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
---

<Layout lang={lang} page="menu" title={t('menu.seoTitle')} description={t('menu.desc')} schema={menuSchema(lang, Astro.site)}>
  <header class="container menu-head">
    <h1>{t('menu.title')}</h1>
    <p class="lead muted">{t('menu.lead')}</p>
  </header>

  <nav class="cats" aria-label={t('menu.jump')} data-cats>
    <div class="container">
      <ul>
        {
          menu.map((s) => (
            <li>
              <a href={`#${s.id}`} data-cat={s.id}>
                {tr(s.title, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="container menu">
    {
      menu.map((section) => (
        <section id={section.id} class="menu-section" data-section>
          <div class="sec-head">
            <h2>{tr(section.title, lang)}</h2>
            {section.twoPrices && (
              <div class="price-cols" aria-hidden="true">
                <span>{t('menu.round')}</span>
                <span>{t('menu.half')}</span>
              </div>
            )}
          </div>

          {section.twoPrices ? (
            <ul class="pizzas">
              {section.items.map((item) => (
                <li class="pizza">
                  <div class="pizza-text">
                    <h3>
                      {tr(item.name, lang)}
                      {item.tag && <em class="tag">{tr(item.tag, lang)}</em>}
                    </h3>
                    <p class="desc muted">{tr(item.desc, lang)}</p>
                  </div>
                  <span class="p">
                    <span class="sr-only">{t('menu.round')}: </span>
                    {item.price} €
                  </span>
                  <span class="p">
                    <span class="sr-only">{t('menu.half')}: </span>
                    {item.half} €
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="dishes">
              {section.items.map((item) => (
                <li class="dish">
                  <div class="row">
                    <h3 class="name">{tr(item.name, lang)}</h3>
                    <span class="dots" />
                    <span class="price">{item.price} €</span>
                  </div>
                  {item.desc && <p class="desc muted">{tr(item.desc, lang)}</p>}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <p class="footnote muted">{t('menu.footnote')}</p>

    <aside class="menu-cta">
      <div>
        <h2>{t('menu.ctaTitle')}</h2>
        <p class="muted">{t('menu.ctaText')}</p>
      </div>
      <a class="btn btn-primary" href={r.contact + '#reserva'}>
        {t('nav.book')}
        <Icon name="arrow" />
      </a>
    </aside>
  </div>

  <script>
    let io: IntersectionObserver | undefined;
    let resizeObs: ResizeObserver | undefined;
    document.addEventListener('astro:page-load', () => {
      io?.disconnect();
      const bar = document.querySelector<HTMLElement>('[data-cats]');
      if (!bar) return;
      const setBarHeight = () =>
        document.documentElement.style.setProperty('--cats-h', bar.offsetHeight + 'px');
      setBarHeight();
      resizeObs?.disconnect();
      resizeObs = new ResizeObserver(setBarHeight);
      resizeObs.observe(bar);
      const links = new Map<string, HTMLAnchorElement>();
      bar.querySelectorAll<HTMLAnchorElement>('[data-cat]').forEach((a) => links.set(a.dataset.cat!, a));

      const setActive = (id: string) => {
        links.forEach((a, key) => {
          const on = key === id;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
        const a = links.get(id);
        const list = bar.querySelector('ul');
        if (a && list) {
          list.scrollTo({
            left: a.offsetLeft - list.clientWidth / 2 + a.clientWidth / 2,
            behavior: 'smooth',
          });
        }
      };

      io = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length) setActive((visible[0].target as HTMLElement).id);
        },
        { rootMargin: '-35% 0px -60% 0px' },
      );
      document.querySelectorAll<HTMLElement>('[data-section]').forEach((s) => io!.observe(s));
    });
    document.addEventListener('astro:before-swap', () => {
      io?.disconnect();
      resizeObs?.disconnect();
      document.documentElement.style.removeProperty('--cats-h');
    });
  </script>
</Layout>

<style>
  /* ── cabecera: alineada con la carta, sin adornos ── */
  .menu-head {
    max-width: 1080px;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .menu-head h1 {
    margin-bottom: 0.75rem;
  }
  .menu-head .lead {
    max-width: 52ch;
    margin: 0;
  }

  /* ── índice de secciones ── */
  .cats {
    position: sticky;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .cats .container {
    max-width: 1080px;
  }
  .cats ul {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cats ul::-webkit-scrollbar {
    display: none;
  }
  .cats a {
    display: block;
    padding: 0.95rem 0 0.8rem;
    border-bottom: 2px solid transparent;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .cats a:hover {
    color: var(--ink);
  }
  .cats a.is-active {
    color: var(--ink);
    border-color: var(--gold);
  }

  /* ── secciones ── */
  .menu {
    max-width: 1080px;
    padding-bottom: var(--section-y);
  }
  .menu-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    /* Se suma al scroll-padding del html (cabecera + 1rem): el total deja la
       sección justo debajo de la barra de categorías. */
    scroll-margin-top: calc(var(--cats-h, 52px) - 1rem);
  }
  .sec-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--ink);
  }
  .sec-head h2 {
    margin: 0;
  }

  .dishes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 4rem;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .name {
    margin: 0;
    font: 600 1.02rem/1.35 var(--font-sans);
    letter-spacing: 0;
  }
  .dots {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 30%, transparent);
    transform: translateY(-4px);
  }
  .price,
  .p {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--gold-ink);
    white-space: nowrap;
  }
  .desc {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* ── pizzas: tabla de carta con dos columnas de precio ── */
  .pizzas,
  .price-cols {
    --col: 6.5rem;
  }
  .price-cols {
    display: grid;
    grid-template-columns: var(--col) var(--col);
    text-align: right;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .pizzas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pizza {
    display: grid;
    grid-template-columns: 1fr var(--col) var(--col);
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .pizza:first-child {
    padding-top: 0;
  }
  .pizza-text {
    max-width: 60ch;
  }
  .pizza h3 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.15;
  }
  .tag {
    margin-left: 0.6rem;
    font: italic 400 1rem/1 var(--font-display);
    color: var(--tomato);
    white-space: nowrap;
  }
  .pizza .p {
    text-align: right;
    font-size: 1.05rem;
  }

  .footnote {
    margin-top: 2rem;
    font-size: 0.85rem;
  }

  .menu-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--ink);
  }
  .menu-cta h2 {
    margin-bottom: 0.25rem;
  }
  .menu-cta p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .dishes {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .pizzas,
    .price-cols {
      --col: 4.6rem;
    }
    .pizza h3 {
      font-size: 1.35rem;
    }
    .tag {
      display: block;
      margin: 0.2rem 0 0;
      font-size: 0.95rem;
    }
    .pizza .p {
      font-size: 0.95rem;
    }
  }
</style>
