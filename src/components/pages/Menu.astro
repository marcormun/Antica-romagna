---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { routes, useTranslations, type Lang } from '../../i18n/ui';
import { menu, tr } from '../../data/menu';
import { menuSchema } from '../../data/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
---

<Layout lang={lang} page="menu" title={t('menu.seoTitle')} description={t('menu.desc')} schema={menuSchema(lang, Astro.site)}>
  <PageHero kicker={t('tagline')} title={t('menu.title')} lead={t('menu.lead')} />

  <nav class="cats" aria-label={t('menu.jump')} data-cats>
    <div class="container">
      <ul>
        {
          menu.map((s) => (
            <li>
              <a href={`#${s.id}`} data-cat={s.id}>
                {tr(s.title, lang)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="container menu">
    {
      menu.map((section) => (
        <section id={section.id} class="menu-section" data-section>
          <div class="sec-head reveal">
            <h2>{tr(section.title, lang)}</h2>
          </div>

          {section.twoPrices ? (
            <ul class="pizzas">
              {section.items.map((item) => (
                <li class="pizza reveal">
                  <div class="pizza-top">
                    <h3>{tr(item.name, lang)}</h3>
                    {item.tag && <span class="pill">{tr(item.tag, lang)}</span>}
                  </div>
                  <p class="desc muted">{tr(item.desc, lang)}</p>
                  <div class="pizza-prices">
                    <span>
                      <small>{t('menu.round')}</small>
                      {item.price} €
                    </span>
                    <span>
                      <small>{t('menu.half')}</small>
                      {item.half} €
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="dishes">
              {section.items.map((item) => (
                <li class="dish reveal">
                  <div class="row">
                    <h3 class="name">{tr(item.name, lang)}</h3>
                    <span class="dots" />
                    <span class="price">{item.price} €</span>
                  </div>
                  {item.desc && <p class="desc muted">{tr(item.desc, lang)}</p>}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <p class="footnote muted">{t('menu.footnote')}</p>

    <aside class="menu-cta reveal">
      <div>
        <h2>{t('menu.ctaTitle')}</h2>
        <p class="muted">{t('menu.ctaText')}</p>
      </div>
      <a class="btn btn-gold" href={r.contact + '#reserva'}>
        {t('nav.book')}
        <Icon name="arrow" />
      </a>
    </aside>
  </div>

  <script>
    let io: IntersectionObserver | undefined;
    let resizeObs: ResizeObserver | undefined;
    document.addEventListener('astro:page-load', () => {
      io?.disconnect();
      const bar = document.querySelector<HTMLElement>('[data-cats]');
      if (!bar) return;
      const setBarHeight = () =>
        document.documentElement.style.setProperty('--cats-h', bar.offsetHeight + 'px');
      setBarHeight();
      resizeObs?.disconnect();
      resizeObs = new ResizeObserver(setBarHeight);
      resizeObs.observe(bar);
      const links = new Map<string, HTMLAnchorElement>();
      bar.querySelectorAll<HTMLAnchorElement>('[data-cat]').forEach((a) => links.set(a.dataset.cat!, a));

      const setActive = (id: string) => {
        links.forEach((a, key) => a.classList.toggle('is-active', key === id));
        const a = links.get(id);
        const list = bar.querySelector('ul');
        if (a && list) {
          list.scrollTo({
            left: a.offsetLeft - list.clientWidth / 2 + a.clientWidth / 2,
            behavior: 'smooth',
          });
        }
      };

      io = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length) setActive((visible[0].target as HTMLElement).id);
        },
        { rootMargin: '-35% 0px -60% 0px' },
      );
      document.querySelectorAll<HTMLElement>('[data-section]').forEach((s) => io!.observe(s));
    });
    document.addEventListener('astro:before-swap', () => {
      io?.disconnect();
      resizeObs?.disconnect();
      document.documentElement.style.removeProperty('--cats-h');
    });
  </script>
</Layout>

<style>
  /* ── barra de categorías ── */
  .cats {
    position: sticky;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .cats ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    justify-content: safe center;
  }
  .cats ul::-webkit-scrollbar {
    display: none;
  }
  .cats a {
    display: block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.3s var(--ease);
  }
  .cats a:hover {
    border-color: var(--ink);
  }
  .cats a.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark);
  }

  /* ── secciones ── */
  .menu {
    max-width: 1080px;
    padding-bottom: var(--section-y);
  }
  .menu-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    /* Se suma al scroll-padding del html (cabecera + 1rem): el total deja la
       sección justo debajo de la barra de categorías. */
    scroll-margin-top: calc(var(--cats-h, 62px) - 1rem);
  }
  .sec-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--ink);
  }
  .sec-head h2 {
    margin: 0;
  }

  .dishes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 4rem;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .name {
    margin: 0;
    font: 600 1.02rem/1.35 var(--font-sans);
    letter-spacing: 0;
  }
  .dots {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 30%, transparent);
    transform: translateY(-4px);
  }
  .price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--gold-ink);
    white-space: nowrap;
  }
  .desc {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* pizzas */
  .pizzas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }
  .pizza {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s;
  }
  .pizza:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .pizza-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pizza h3 {
    margin: 0;
    font-size: 1.6rem;
  }
  .pizza .desc {
    flex: 1;
    margin: 0.4rem 0 1.1rem;
  }
  .pizza-prices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
  }
  .pizza-prices span {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--gold-ink);
    font-size: 1.05rem;
  }
  .pizza-prices small {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footnote {
    margin-top: 1rem;
    font-size: 0.85rem;
  }

  .menu-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--on-dark);
  }
  .menu-cta h2 {
    margin-bottom: 0.25rem;
  }
  .menu-cta p {
    margin: 0;
    color: var(--on-dark-muted);
  }

  @media (max-width: 760px) {
    .dishes {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }
</style>
