---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { routes, useTranslations, type Lang } from '../../i18n/ui';
import { featured, menu, tr } from '../../data/menu';
// Fotos de muestra provisionales (Unsplash) — sustituir por fotos reales del local
import galSala from '../../assets/img/stock/sala-toscana.webp';
import galPizza from '../../assets/img/stock/pizza-margherita.webp';
import galPasta from '../../assets/img/stock/ravioli.webp';
import galPostre from '../../assets/img/stock/tiramisu.webp';
import heroImg from '../../assets/img/stock/horno-lena.webp';
import ctaImg from '../../assets/img/stock/brindis-mesa.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const pizzaCount = menu.find((s) => s.id === 'pizzas')?.items.length ?? 0;

const gallery = [
  { src: galPizza, alt: 'Pizza margherita', cls: 'g-big' },
  { src: galPasta, alt: lang === 'ca' ? 'Ravioli frescos fets a mà' : 'Ravioli frescos hechos a mano', cls: '' },
  { src: galPostre, alt: 'Tiramisú', cls: '' },
  { src: galSala, alt: lang === 'ca' ? 'Sala amb taules i cadires de fusta' : 'Sala con mesas y sillas de madera', cls: 'g-wide' },
];
---

<Layout lang={lang} page="home" title={t('home.title')} description={t('home.desc')} overlayHeader>
  <!-- HERO -->
  <section class="hero section-dark">
    <div class="hero-bg" aria-hidden="true">
      <Image
        class="hero-img"
        src={heroImg}
        alt=""
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="kicker reveal">{t('tagline')}</p>
        <h1 class="reveal" style="--d:80ms">
          {t('home.h1a')}<br />
          <em>{t('home.h1b')}</em><br />
          {t('home.h1c')}
        </h1>
        <p class="lead reveal" style="--d:160ms">{t('home.lead')}</p>
        <div class="hero-cta reveal" style="--d:240ms">
          <a class="btn btn-gold" href={r.contact + '#reserva'}>
            {t('nav.book')}
            <Icon name="arrow" />
          </a>
          <a class="btn btn-ghost-light" href={r.menu}>{t('home.ctaMenu')}</a>
        </div>
      </div>
    </div>

    <div class="container hero-foot reveal" style="--d:360ms">
      <dl class="facts">
        <div><dt>{pizzaCount}</dt><dd>{t('home.fact1')}</dd></div>
        <div><dt>{t('home.fact2v')}</dt><dd>{t('home.fact2')}</dd></div>
        <div><dt>{t('home.fact3v')}</dt><dd>{t('home.fact3')}</dd></div>
      </dl>
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <div>
          <strong>{t('home.badge')}</strong>
          <span>{t('home.badgeSub')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CARTA -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="reveal">
          <p class="kicker">{t('home.menuKicker')}</p>
          <h2>{t('home.menuTitle')}</h2>
        </div>
        <a class="link-arrow reveal" href={r.menu}>{t('home.menuAll')} <Icon name="arrow" /></a>
      </div>
      <div class="menu-cards">
        {
          featured.map((group, i) => (
            <article class="card menu-card reveal" style={`--d:${i * 90}ms`}>
              <h3>{tr(group.title, lang)}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <div class="row">
                      <span class="name">{tr(item.name, lang)}</span>
                      <span class="dots" />
                      <span class="price">{item.price} €</span>
                    </div>
                    <p class="desc muted">{tr(item.desc, lang)}</p>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="section gallery-section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="kicker">{t('home.galleryKicker')}</p>
          <h2>{t('home.galleryTitle')}</h2>
        </div>
      </div>
      <div class="gallery">
        {
          gallery.map((g, i) => (
            <figure class={`media reveal ${g.cls}`} style={`--d:${i * 80}ms`}>
              <Image src={g.src} alt={g.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 92vw, 40vw" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-wrap">
    <div class="container">
      <div class="cta reveal">
        <Image class="cta-bg" src={ctaImg} alt="" widths={[640, 1000, 1600]} sizes="(max-width: 1200px) 100vw, 1100px" />
        <div class="cta-body">
          <h2>{t('home.ctaTitle')}</h2>
          <p class="lead">{t('home.ctaText')}</p>
          <div class="hero-cta">
            <a class="btn btn-gold" href={r.contact + '#reserva'}>
              {t('nav.book')}
              <Icon name="arrow" />
            </a>
            <a class="btn btn-ghost-light" href={r.contact}>{t('home.ctaHours')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dark);
  }
  .hero-bg :global(.hero-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 66%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }
  /* Degradado: oscuro a la izquierda para el texto, abierto a la derecha para la foto */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(20 16 13) 34%, rgb(20 16 13 / 0.75) 44%, rgb(20 16 13 / 0.15) 60%, rgb(20 16 13 / 0) 72%),
      linear-gradient(0deg, rgb(20 16 13 / 0.9) 0%, rgb(20 16 13 / 0) 30%),
      linear-gradient(180deg, rgb(20 16 13 / 0.55) 0%, rgb(20 16 13 / 0) 22%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg :global(.hero-img) {
      animation: hero-zoom 2.8s var(--ease) both;
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.1);
      opacity: 0.4;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .hero-inner {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .hero-copy {
    max-width: 640px;
  }
  .hero h1 {
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.35);
  }
  .hero h1 em {
    color: var(--gold);
    font-weight: 400;
  }
  .hero .lead {
    max-width: 46ch;
    color: color-mix(in srgb, var(--on-dark) 82%, transparent);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    position: relative;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.75rem;
  }
  .hero-foot::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: color-mix(in srgb, var(--on-dark) 16%, transparent);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
  }
  .facts dt {
    font: 500 2.1rem/1 var(--font-display);
    color: var(--on-dark);
  }
  .facts dd {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: rgb(27 22 18 / 0.45);
    border: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .hero-badge strong {
    display: block;
    font-weight: 700;
  }
  .hero-badge span:not(.badge-dot) {
    color: var(--on-dark-muted);
  }
  .badge-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e0874a;
    box-shadow: 0 0 0 5px rgb(224 135 74 / 0.22), 0 0 14px rgb(224 135 74 / 0.8);
    flex: none;
  }

  /* ── carta destacada ── */
  .menu-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .menu-card {
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .menu-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .menu-card h3 {
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .menu-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .name {
    font-weight: 600;
  }
  .dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 30%, transparent);
    transform: translateY(-4px);
  }
  .price {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--gold-ink);
    white-space: nowrap;
  }
  .desc {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* ── galería ── */
  .gallery-section {
    padding-top: 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(180px, 22vw, 280px);
    gap: 1rem;
  }
  .gallery figure {
    margin: 0;
    border-radius: var(--radius);
  }
  .g-big {
    grid-row: span 2;
  }
  .g-wide {
    grid-column: span 2;
  }

  /* ── CTA ── */
  .cta-wrap {
    padding-top: 0;
  }
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--on-dark);
    isolation: isolate;
  }
  .cta :global(.cta-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    z-index: -2;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(27 22 18 / 0.94) 30%, rgb(27 22 18 / 0.55));
  }
  .cta-body {
    max-width: 560px;
    padding: clamp(2.5rem, 7vw, 5.5rem);
  }
  .cta-body .lead {
    color: var(--on-dark-muted);
  }

  /* ── responsive ── */
  @media (max-width: 960px) {
    .menu-cards {
      grid-template-columns: 1fr 1fr;
    }
    .menu-cards > :last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 860px) {
    .hero {
      min-height: max(100svh, 640px);
    }
    .hero-bg :global(.hero-img) {
      width: 100%;
      object-position: 55% center;
    }
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        rgb(20 16 13 / 0.6) 0%,
        rgb(20 16 13 / 0.45) 30%,
        rgb(20 16 13 / 0.82) 62%,
        rgb(20 16 13 / 0.96) 100%
      );
    }
    .hero-inner {
      align-items: flex-end;
    }
    .hero-badge {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .facts {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      gap: 1rem;
    }
    .facts dt {
      font-size: 1.6rem;
    }
    .facts dd {
      font-size: 0.68rem;
    }
    .menu-cards {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 42vw;
    }
    .g-big {
      grid-row: span 1;
      grid-column: span 2;
    }
  }
</style>
