---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { routes, site, hoursTable, useTranslations, type Lang } from '../../i18n/ui';
import { featured, tr } from '../../data/menu';
// Fotos de muestra provisionales (Unsplash) — sustituir por fotos reales del local
import galSala from '../../assets/img/stock/sala-toscana.webp';
import galPizza from '../../assets/img/stock/pizza-margherita.webp';
import galPasta from '../../assets/img/stock/ravioli.webp';
import galPostre from '../../assets/img/stock/tiramisu.webp';
import heroImg from '../../assets/img/stock/horno-lena.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];

const gallery = [
  { src: galPizza, alt: 'Pizza margherita', cls: 'g-big' },
  { src: galPasta, alt: lang === 'ca' ? 'Ravioli frescos fets a mà' : 'Ravioli frescos hechos a mano', cls: '' },
  { src: galPostre, alt: 'Tiramisú', cls: '' },
  { src: galSala, alt: lang === 'ca' ? 'Sala amb taules i cadires de fusta' : 'Sala con mesas y sillas de madera', cls: 'g-wide' },
];
---

<Layout lang={lang} page="home" title={t('home.title')} description={t('home.desc')} overlayHeader>
  <!-- HERO -->
  <section class="hero section-dark">
    <div class="hero-bg" aria-hidden="true">
      <Image
        class="hero-img"
        src={heroImg}
        alt=""
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{t('home.h1a')} {t('home.h1b')} {t('home.h1c')}</h1>
        <p class="lead">{t('home.lead')}</p>
        <div class="hero-cta">
          <a class="btn btn-gold" href={r.contact + '#reserva'}>
            {t('nav.book')}
            <Icon name="arrow" />
          </a>
          <a class="btn btn-ghost-light" href={r.menu}>{t('home.ctaMenu')}</a>
        </div>
      </div>
    </div>

    <!-- Lo práctico: horario y dirección, a la vista desde el primer pantallazo -->
    <div class="container hero-foot">
      <dl class="hours">
        {
          hoursTable[lang].map((row) => (
            <div>
              <dt>{row.days}</dt>
              <dd>{row.hours ?? t('contact.closed')}</dd>
            </div>
          ))
        }
      </dl>
      <a class="where" href={site.mapsUrl} target="_blank" rel="noopener">
        <span>{site.street}, Martorell</span>
        <span class="where-link">{t('contact.directions')} <Icon name="arrow" /></span>
      </a>
    </div>
  </section>

  <!-- CARTA -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.menuTitle')}</h2>
        <a class="link-arrow" href={r.menu}>{t('home.menuAll')} <Icon name="arrow" /></a>
      </div>
      <div class="menu-cols">
        {
          featured.map((group) => (
            <section class="menu-col">
              <h3>{tr(group.title, lang)}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <div class="row">
                      <span class="name">{tr(item.name, lang)}</span>
                      <span class="dots" />
                      <span class="price">{item.price} €</span>
                    </div>
                    <p class="desc muted">{tr(item.desc, lang)}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="section gallery-section">
    <div class="container">
      <div class="section-head">
        <h2>{t('home.galleryTitle')}</h2>
      </div>
      <div class="gallery">
        {
          gallery.map((g) => (
            <figure class={`media ${g.cls}`}>
              <Image src={g.src} alt={g.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 92vw, 40vw" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark cta">
    <div class="container cta-inner">
      <div>
        <h2>{t('home.ctaTitle')}</h2>
        <p class="lead">{t('home.ctaText')}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-gold" href={r.contact + '#reserva'}>
          {t('nav.book')}
          <Icon name="arrow" />
        </a>
        <a class="btn btn-ghost-light" href={r.contact}>{t('home.ctaHours')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dark);
  }
  .hero-bg :global(.hero-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 66%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }
  /* Degradado: oscuro a la izquierda para el texto, abierto a la derecha para la foto */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(20 16 13) 34%, rgb(20 16 13 / 0.75) 44%, rgb(20 16 13 / 0.15) 60%, rgb(20 16 13 / 0) 72%),
      linear-gradient(0deg, rgb(20 16 13 / 0.9) 0%, rgb(20 16 13 / 0) 30%);
  }
  /* El único momento animado de la página: el horno se enciende */
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg :global(.hero-img) {
      animation: hero-glow 1.6s var(--ease) both;
    }
  }
  @keyframes hero-glow {
    from {
      transform: scale(1.04);
      filter: brightness(0.55) saturate(0.7);
    }
    to {
      transform: none;
      filter: none;
    }
  }

  .hero-inner {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .hero-copy {
    max-width: 600px;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.02;
    margin-bottom: 1.5rem;
  }
  .hero .lead {
    max-width: 46ch;
    color: color-mix(in srgb, var(--on-dark) 82%, transparent);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    position: relative;
    padding-top: 1.5rem;
  }
  .hero-foot::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: color-mix(in srgb, var(--on-dark) 16%, transparent);
  }
  .hours {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .hours dt {
    color: var(--on-dark-muted);
  }
  .hours dd {
    margin: 0.15rem 0 0;
    font-variant-numeric: tabular-nums;
    color: var(--on-dark);
  }
  .where {
    display: grid;
    gap: 0.15rem;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--on-dark-muted);
    text-decoration: none;
    text-align: right;
  }
  .where-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    color: var(--on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.3em;
  }
  .where-link :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--ease);
  }
  .where:hover .where-link :global(svg) {
    transform: translateX(3px);
  }

  /* ── carta destacada: como una carta de verdad, sin tarjetas ── */
  .menu-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
  }
  .menu-col {
    padding: 1.75rem clamp(1.25rem, 2.5vw, 2.25rem) 0;
  }
  .menu-col:first-child {
    padding-left: 0;
  }
  .menu-col:last-child {
    padding-right: 0;
  }
  .menu-col + .menu-col {
    border-left: 1px solid var(--line);
  }
  .menu-col h3 {
    margin-bottom: 1.5rem;
  }
  .menu-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .name {
    font-weight: 600;
  }
  .dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 30%, transparent);
    transform: translateY(-4px);
  }
  .price {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--gold-ink);
    white-space: nowrap;
  }
  .desc {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* ── galería ── */
  .gallery-section {
    padding-top: 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(180px, 22vw, 280px);
    gap: 0.5rem;
  }
  .gallery figure {
    margin: 0;
    border-radius: var(--radius-sm);
  }
  .g-big {
    grid-row: span 2;
  }
  .g-wide {
    grid-column: span 2;
  }

  /* ── CTA ── */
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta-inner h2 {
    margin-bottom: 0.75rem;
  }
  .cta .lead {
    max-width: 48ch;
    margin: 0;
    color: var(--on-dark-muted);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── responsive ── */
  @media (max-width: 860px) {
    .hero {
      min-height: max(100svh, 640px);
    }
    .hero-bg :global(.hero-img) {
      width: 100%;
    }
    .hero-bg::after {
      background: linear-gradient(
        180deg,
        rgb(20 16 13 / 0.6) 0%,
        rgb(20 16 13 / 0.45) 30%,
        rgb(20 16 13 / 0.82) 62%,
        rgb(20 16 13 / 0.96) 100%
      );
    }
    .hero-inner {
      align-items: flex-end;
    }
    .where {
      text-align: left;
    }
    .where-link {
      justify-content: flex-start;
    }
    .menu-cols {
      grid-template-columns: 1fr;
    }
    .menu-col,
    .menu-col:first-child,
    .menu-col:last-child {
      padding: 1.75rem 0 2rem;
    }
    .menu-col + .menu-col {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 42vw;
    }
    .g-big {
      grid-row: span 1;
      grid-column: span 2;
    }
  }
</style>
